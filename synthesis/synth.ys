# Read RTL
read_verilog ../rtl/railway_level_crossing_monitor.v

# Elaborate design
hierarchy -check -top railway_level_crossing_monitor

# Synthesize to generic gates
synth -top railway_level_crossing_monitor

# Map flip-flops to library sequential cells (absolute path)
dfflibmap -liberty /home/vsduser/Desktop/work/tools/openlane_working_dir/pdks/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib

# Map combinational logic to library gates via ABC (absolute path)
abc -liberty /home/vsduser/Desktop/work/tools/openlane_working_dir/pdks/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib

# Clean up and write results
opt_clean
write_verilog -noattr ./mapped_railway_level_crossing_monitor.v
stat
